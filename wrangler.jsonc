{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stack-summary",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "APP_ORIGIN": ""
  },
  "secrets": {
    "required": ["OWNER_EMAIL"]
  }
}
