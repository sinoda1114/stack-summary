{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stack-summary",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "APP_ORIGIN": "",
    "GEMINI_MODEL": "gemini-flash-latest",
    "IMPORT_MAX_CHARS": "50000"
  },
  "secrets": {
    "required": ["OWNER_EMAIL", "GEMINI_API_KEY"]
  },
  // 段階 2 はローカル D1。リモートの database_id は本番配置の前に置く。
  "workflows": [
    {
      "name": "stack-summary-import",
      "binding": "IMPORT_WORKFLOW",
      "class_name": "ImportWorkflow"
    }
  ],
  "assets": {
    "directory": "./client-shell",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stack-summary",
      "migrations_dir": "migrations"
    }
  ]
}
