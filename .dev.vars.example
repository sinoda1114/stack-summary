# ローカルの secret と var。このファイルはコミットする。実値は .dev.vars に書き、コミットしない。
# 固定ユーザーで JWT を読み替える分岐は、本番の Worker に入れない。
ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
ACCESS_AUD=replace-me
OWNER_EMAIL=owner@example.com
APP_ORIGIN=http://localhost:8787
GEMINI_API_KEY=replace-me
# 仮。生成のみ。技術名の抽出と、問い合わせの答え。
GEMINI_MODEL_LIGHT=gemini-flash-lite-latest
# 仮。生成のみ。メモの題、本文、日付。
GEMINI_MODEL_HEAVY=gemini-flash-latest
IMPORT_MAX_CHARS=50000
