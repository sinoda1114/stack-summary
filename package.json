{
  "name": "stack-summary",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "types": "wrangler types --strict-vars false --include-runtime false",
    "typecheck": "wrangler types --strict-vars false --include-runtime false --check && tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run && vitest run --config vitest.client.config.ts",
    "eval:classify": "node --experimental-strip-types scripts/eval-classify.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261010.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.149.0"
  }
}
